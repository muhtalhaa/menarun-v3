# PostgreSQL connection (Neon on Vercel, or local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/menarun?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# App URL (local dev or production)
AUTH_URL="http://localhost:3000"

# Timezone for daily rate limits
TZ="Asia/Jakarta"
