generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Participant {
  id         String           @id @default(uuid())
  token      String           @unique @db.VarChar(12)
  nama       String           @db.VarChar(100)
  noAims     String           @unique @map("no_aims") @db.Char(5)
  majlis     String           @db.VarChar(150)
  email      String           @db.VarChar(255)
  usia       Int              @db.SmallInt
  noHp       String           @map("no_hp") @db.VarChar(20)
  createdAt  DateTime         @default(now()) @map("created_at")
  activities Activity[]
  bans       ParticipantBan[]
  reportsSubmitted ActivityReport[] @relation("ReporterReports")
  reportsReceived  ActivityReport[] @relation("ReportedReports")

  @@index([majlis])
  @@index([email])
  @@map("participants")
}

model Event {
  id             String     @id @default(uuid())
  nama           String     @db.VarChar(150)
  deskripsi      String     @db.Text
  tanggalMulai   DateTime   @map("tanggal_mulai") @db.Date
  tanggalSelesai DateTime   @map("tanggal_selesai") @db.Date
  jamMulaiSubmit String     @default("00:00") @map("jam_mulai_submit") @db.VarChar(5)
  jamBatasSubmit String     @default("23:59") @map("jam_batas_submit") @db.VarChar(5)
  isActive       Boolean    @default(true) @map("is_active")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  activities     Activity[]
  bans           ParticipantBan[]
  activityReports ActivityReport[]

  @@index([isActive, tanggalSelesai(sort: Desc)])
  @@map("events")
}

model Activity {
  id               String      @id @default(uuid())
  participantId    String      @map("participant_id")
  eventId          String      @map("event_id")
  stravaUrl        String      @map("strava_url") @db.VarChar(500)
  stravaActivityId String?     @map("strava_activity_id") @db.VarChar(50)
  distanceKm       Decimal     @map("distance_km") @db.Decimal(8, 2)
  durationSec      Int         @map("duration_sec")
  durationType     String      @default("moving") @map("duration_type") @db.VarChar(10)
  pacePerKm        String?     @map("pace_per_km") @db.VarChar(10)
  elevationM       Int         @default(0) @map("elevation_m")
  activityDate     DateTime    @map("activity_date") @db.Date
  rawMeta          Json?       @map("raw_meta")
  submittedAt      DateTime    @default(now()) @map("submitted_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  participant      Participant @relation(fields: [participantId], references: [id])
  event            Event       @relation(fields: [eventId], references: [id])

  @@unique([stravaActivityId, eventId])
  @@unique([stravaActivityId])
  @@index([eventId, participantId])
  @@index([participantId, eventId, submittedAt])
  @@index([participantId, submittedAt])
  @@index([eventId, distanceKm(sort: Desc)])
  @@map("activities")
}

model ParticipantBan {
  id             String      @id @default(uuid())
  participantId  String      @map("participant_id")
  eventId        String      @map("event_id")
  tanggalMulai   DateTime    @map("tanggal_mulai") @db.Date
  tanggalSelesai DateTime    @map("tanggal_selesai") @db.Date
  createdAt      DateTime    @default(now()) @map("created_at")
  participant    Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  event          Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([participantId, eventId])
  @@map("participant_bans")
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  nama         String   @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admins")
}

model Majlis {
  id       Int     @id @default(autoincrement())
  nama     String  @unique @db.VarChar(150)
  isActive Boolean @default(true) @map("is_active")

  @@map("majlis")
}

model ActivityReport {
  id                    String      @id @default(uuid())
  eventId               String      @map("event_id")
  reportedParticipantId String      @map("reported_participant_id")
  reporterParticipantId String      @map("reporter_participant_id")
  detail                String      @db.Text
  createdAt             DateTime    @default(now()) @map("created_at")
  event                 Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reportedParticipant   Participant @relation("ReportedReports", fields: [reportedParticipantId], references: [id], onDelete: Cascade)
  reporterParticipant   Participant @relation("ReporterReports", fields: [reporterParticipantId], references: [id], onDelete: Cascade)

  @@index([eventId, reportedParticipantId])
  @@index([reporterParticipantId, createdAt(sort: Desc)])
  @@map("activity_reports")
}
